{
  "root": true,
  "env": {
    "browser": true,
    "amd": true,
    "node": true,
    "serviceworker": true,
    "worker": true,
    "es2024": true
  },
  "globals": {
    "define": "readonly",
    "workbox": "readonly",
    "FetchEvent": "readonly",
